# ─────────────────────────────────────────────────────────────────────────────
# SafeHer environment variables
# Copy to `.env.local` for local development. NEVER commit real values.
# On Vercel, set these under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase client SDK (public, safe to expose; protected by Security Rules) ──
# When NEXT_PUBLIC_FIREBASE_API_KEY is empty, SafeHer runs in DEMO MODE.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push certificate key pair (Firebase console → Cloud Messaging → Web configuration)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Firebase Admin SDK (SERVER ONLY — secret) ──
# Service account credentials. Keep the literal "\n" sequences in the private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Google Maps (public key — restrict by HTTP referrer in Google Cloud console) ──
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Demo mode ──
# Demo mode is automatic in development when Firebase is not configured.
# In production it is OFF unless this is explicitly "true" (e.g. a portfolio showcase).
# Demo data is in-memory and resets on server restart / serverless cold start.
NEXT_PUBLIC_DEMO_MODE=
# HMAC secret used to sign demo session tokens (min 32 chars). Required if demo mode is on in production.
DEMO_SESSION_SECRET=

# ── Scheduled jobs (Vercel Cron) ──
# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron routes.
CRON_SECRET=
